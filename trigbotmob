-- ==================== TRIGGERBOT LOGIC ====================
-- This is the part that was completely broken before.
-- You'll need to finish the actual trigger logic depending on the game.

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
raycastParams.IgnoreWater = true

local lastTriggerTime = 0

RunService.Heartbeat:Connect(function()
    if Config.Panic or not Config.Enabled then return end
    if tick() - lastTriggerTime < Config.Delay then return end

    local character = LocalPlayer.Character
    if not character then return end

    local tool = character:FindFirstChildWhichIsA('Tool')
    if not tool then return end

    local ammo = tool:FindFirstChild('Ammo')
    if not ammo or not (ammo:IsA('IntValue') or ammo:IsA('NumberValue')) then return end
    if ammo.Value <= 0 then return end

    -- Basic triggerbot logic (you'll need to customize this for the specific game)
    -- Example: shoot when mouse is over an enemy

    local mouse = LocalPlayer:GetMouse()
    local target = mouse.Target

    if target and target.Parent then
        local humanoid = target.Parent:FindFirstChildWhichIsA('Humanoid')
        if humanoid and humanoid.Health > 0 and target.Parent \~= character then

            -- Wall check
            if Config.WallCheck then
                local origin = Camera.CFrame.Position
                local direction = (mouse.Hit.Position - origin).Unit * 500
                local result = workspace:Raycast(origin, direction, raycastParams)

                if not result or result.Instance \~= target then
                    return -- blocked by wall
                end
            end

            -- Trigger shot (simulate mouse click or fire the tool)
            lastTriggerTime = tick()

            -- Most games use mouse1 click simulation or tool:Activate()
            tool:Activate()   -- Try this first

            -- Alternative for some games:
            -- mouse1press simulation via VirtualInputManager (if your executor supports it)
        end
    end
end)

