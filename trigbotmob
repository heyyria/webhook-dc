TBData.Name = 'TBData'
TBData.Parent = PlayerGui

local cfgValue = TBData:FindFirstChild('cfg') or Instance.new('StringValue')
cfgValue.Name = 'cfg'
cfgValue.Parent = TBData

-- Load config or use defaults
local Config = {
    Prediction = 0.134,
    ShowUIButton = true,
    Panic = false,
    ShowCredits = true,
    Enabled = true,
    Delay = 0.1,
    WallCheck = true,
}

if cfgValue.Value and cfgValue.Value \~= "" then
    local success, decoded = pcall(function()
        return HttpService:JSONDecode(cfgValue.Value)
    end)
    if success then
        for k, v in pairs(decoded) do
            Config[k] = v
        end
    end
end

-- Save config function
local function SaveConfig()
    local success, encoded = pcall(function()
        return HttpService:JSONEncode(Config)
    end)
    if success then
        cfgValue.Value = encoded
    end
end

