-- Helper to create toggle buttons
local function CreateToggle(text, default, callback)
    local btn = Instance.new('TextButton')
    btn.Size = UDim2.new(1, -20, 0, 50)
    btn.BackgroundColor3 = default and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(30, 30, 30)
    btn.Text = text .. (default and ": ON" or ": OFF")
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 20
    btn.Parent = Scrolling

    local corner = Instance.new('UICorner', btn)
    corner.CornerRadius = UDim.new(0, 10)

    btn.MouseButton1Click:Connect(function()
        local newState = not (btn.Text:find("ON") \~= nil)
        btn.Text = text .. (newState and ": ON" or ": OFF")
        btn.BackgroundColor3 = newState and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(30, 30, 30)
        callback(newState)
    end)

    return btn
end

