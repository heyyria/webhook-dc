-- RightShift to toggle menu
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        MainFrame.Visible = not MainFrame.Visible
    elseif input.KeyCode == Enum.KeyCode.K then
        -- Panic key
        Config.Enabled = false
        EnabledBtn.Text = 'Enabled: OFF'
        EnabledBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        SaveConfig()
        StarterGui:SetCore('SendNotification', {Text = 'Panic! Triggerbot Disabled', Title = 'TRIGGERBOT', Duration = 3})
    end
end)

-- Raycast params for WallCheck
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Blacklist
RayParams.IgnoreWater = true

-- Main Triggerbot Loop
local lastTrigger = 0

RunService.Heartbeat:Connect(function()
    if not Config.Enabled then return end
    if tick() - lastTrigger < Config.Delay then return end

    local Character = LocalPlayer.Character
    if not Character then return end

    local Tool = Character:FindFirstChildWhichIsA('Tool')
    if not Tool then return end

    local Ammo = Tool:FindFirstChild('Ammo')
    if not Ammo or not Ammo:IsA('IntValue') or Ammo.Value <= 0 then return end

    -- Get target (mouse target with prediction)
    local Target = Mouse.Target
    if not Target then return end

    local TargetRoot = Target:FindFirstAncestorWhichIsA('Model')
    if not TargetRoot or not TargetRoot:FindFirstChild('Humanoid') then return end
    if TargetRoot == Character then return end

    -- WallCheck
    if Config.WallCheck then
        local Origin = Camera.CFrame.Position
        local Direction = (Mouse.Hit.Position - Origin)
        local Result = workspace:Raycast(Origin, Direction * Config.Prediction, RayParams)
        
        if Result and Result.Instance and Result.Instance:IsDescendantOf(TargetRoot) then
            -- Clear line of sight
        else
            return
        end
    end

    -- Trigger (simulate click)
    mouse1click()  -- or use VirtualInputManager for more stealth if needed
    lastTrigger = tick()
end)

